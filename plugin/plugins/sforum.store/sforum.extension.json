        "icon": "i-lucide-store",
        "label": "商城",
        "menu": true,
        "order": 30,
        "path": "/catalog",
        "view": "component"
      },
      {
        "description": "配置商城地址与默认频道；保存、重置与脱敏由宿主负责。",
        "group": "应用商城",
        "icon": "i-lucide-settings-2",
        "label": "设置",
        "menu": true,
        "order": 40,
        "path": "/settings",
        "permission": "extension.plugin.manage",
        "view": "settings"
      }
    ]
