{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sforum.store.install-url.response@1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "size",
        "expiresAt"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAt": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  ]
}
