{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sforum.store.install-url.request@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "os",
    "arch"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "os": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "arch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    }
  }
}
