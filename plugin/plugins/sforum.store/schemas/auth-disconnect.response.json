{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sforum.store.auth-disconnect.response@1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["connected", "revoked"],
      "properties": {
        "connected": { "type": "boolean", "const": false },
        "revoked": {
          "type": "boolean",
          "description": "商城是否确认撤销；false 表示本地已清、上游撤销失败（不影响断开结果）。"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  ]
}
