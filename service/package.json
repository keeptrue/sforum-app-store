{
  "name": "service",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "bun --bun next build",
    "start": "bun --bun next start -p 4000",
    "worker": "bun --env-file=.env.local src/worker.ts",
    "contract:generate": "openapi-typescript ../contracts/store-api.yaml -o src/lib/api-types.ts",
    "manifest:sync": "bun scripts/sync-manifest-schema.ts",
    "manifest:check": "bun scripts/sync-manifest-schema.ts --check",
    "manifest:conformance": "bun scripts/manifest-conformance.ts",
    "capabilities:sync": "bun scripts/sync-capability-catalog.ts",
    "capabilities:check": "bun scripts/sync-capability-catalog.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local src/db/migrate.ts",
    "test": "bun test --parallel=1",
    "seed:dev": "bun --env-file=.env.local scripts/seed-dev.ts",
    "admin:password": "bun --env-file=.env.local scripts/admin-password.ts",
    "admin:reset-password": "bun scripts/admin-reset-password.ts",
    "settings:public-url": "bun scripts/settings-public-url.ts",
    "backup:legacy-media": "bun --env-file=.env.local scripts/backup-legacy-media.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "readme:rerender": "bun --env-file=.env.local scripts/readme-rerender.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "file-type": "^19",
    "highlight.js": "^11.12.0",
    "image-size": "^2",
    "lucide-react": "^1.61.0",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "sanitize-html": "^2.18.1",
    "semver": "^7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yauzl": "^3.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "yazl": "^3.3.1"
  }
}
