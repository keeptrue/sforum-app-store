# Public base URL used for OAuth callbacks and signed download links.
# The service listens on 4000 by default (see service/package.json dev/start).
#
# SEED ONLY. Still required at boot, but no longer the only way to set the address: once an
# operator saves one in the admin console ("系统设置", default /admin/settings/general), the
# `store_settings` row wins and this line is only what "恢复默认" (or a --clear) falls back to.
# Keep it correct anyway — a fresh database and a cleared row both start from it.
#
# Every browser-visible absolute URL is derived from the *effective* address: OAuth callback,
# error redirects, download short links, GitHub webhook / Setup URL, the baseline `isSameOrigin`
# compares against, and the session cookie name plus its `Secure` flag. If a proxy or tunnel
# sits in front of the process, set the URL visitors actually use (and register that same
# callback in the forum's OAuth app; the provider matches redirect URIs exactly). Changing it in
# the console takes effect on the next request, no restart; other processes converge within 15 s.
# `GET /api/health` echoes the resolved value plus `publicUrlSource` (database | env).
STORE_PUBLIC_URL=http://127.0.0.1:4000

# Extra hosts allowed to reach the DEV server cross-origin (`next dev` only; ignored by a
# production build). Comma separated; `*` matches one subdomain. Needed whenever a proxy or
# tunnel puts another hostname in front of `next dev`, otherwise Next answers /_next/* and
# /__nextjs* with 403 and the error overlay plus HMR go dark.
# STORE_DEV_ORIGINS=*.trycloudflare.com

# Shown by /api/health and the UI footer.
STORE_BUILD_VERSION=dev
STORE_BUILD_COMMIT=local

# Signed download tokens (S3). Min 32 chars; rotate = old links die instantly.
# STORE_DOWNLOAD_SECRET=change-me-32-chars-minimum-secret

# How GET /api/v1/download/{token} answers.
#   proxy    (default) stream the ZIP through this process: one trust chain, a yank is a 410
#            on the very next request, and every byte is billed to this machine.
#   redirect give the client the signed object URL GitHub already minted, for PUBLIC
#            repositories only, so the bytes never touch this machine. The five checks still
#            run here, but a 302 that was already answered cannot be revoked — see
#            knowledge/decisions/2026-10-25-download-redirect-mode.md. Private repositories
#            always proxy (their object URL names the repository, tag and file).
# Anything other than these two values fails at boot. This is the SEED: 系统设置 里的「下载分发」
# can pin proxy / redirect or follow this value, and a save takes effect on the next request
# (no restart). Only a deployment that never touched that page is governed by this line.
# STORE_DOWNLOAD_MODE=proxy
# Content-addressed image store root (S3). Defaults to service/.data/assets.
# STORE_ASSET_DIR=/var/lib/sforum-store/assets

# Rate limits (S6). Format "<limit>/<seconds>"; invalid values fail at boot.
# These are the DEFAULT layer only: the admin console ("系统设置") can override each of the six
# channels per deployment. A console field left empty inherits the value here (or the built-in
# default when this line is absent); `--clear` returns every channel to this layer. The console
# refuses an admin-login value below 3 attempts per window; this layer has no such floor.
# STORE_RATELIMIT_LOGIN=10/300
# STORE_RATELIMIT_ADMIN_LOGIN=10/300
# STORE_RATELIMIT_SUBMIT=30/3600
# STORE_RATELIMIT_DOWNLOAD_IP=60/300
# STORE_RATELIMIT_DOWNLOAD_TOKEN=20/300
# STORE_RATELIMIT_REPO=30/3600

# Encryption keyring for forum tokens and issuer client secrets (kid:base64(32 bytes)).
# STORE_SECRET_KEYS=2026-10:base64key
# DATABASE_URL=postgres://store:store@127.0.0.1:5432/store

# --- Runtime settings (console-editable) ----------------------------------------------
# The effective values of the public URL, the download-link TTL and the six rate-limit channels
# live in the single `store_settings` row and are edited in the admin console:
#   /<STORE_ADMIN_PATH>/settings/general      (default /admin/settings/general)
# Resolution order is `store_settings` row > env seed from this file. A save is in effect on the
# next request in the process that served it; other processes and replicas converge within 15 s
# (in-process cache, no LISTEN/NOTIFY by design). `DELETE /api/admin/settings` drops the row, so
# every key returns to the seed.
#
# Locked out of the console by a bad address? Recover without it:
#   bun run settings:public-url -- --show
#   bun run settings:public-url -- --set https://store.example.com
#   bun run settings:public-url -- --clear
#
# Still env-only, deliberately: STORE_SESSION_SECRET / STORE_DOWNLOAD_SECRET / STORE_SECRET_KEYS /
# DATABASE_URL / STORE_ASSET_DIR (signing roots and boot-time dependencies; rotating them is a
# separate feature), STORE_ADMIN_PATH (changing it 404s the current console URL), and
# STORE_ADMIN_SETUP_TOKEN (one-shot authorization surface). Session/state TTLs stay code
# constants because they are security policy, not deployment preference.

# --- Admin console -------------------------------------------------------------------
# Path segment of the admin console. Single segment, read at request time: change it and
# restart, no rebuild. Reserved words (/api, /dashboard, /moderation, /p, /_next) fail at boot.
# STORE_ADMIN_PATH=/admin

# One-shot token that authorises creating the FIRST administrator. Without it the
# registration route is closed (the page shows how to generate one) — an open form on a
# public URL is a takeover window. Generate with: openssl rand -base64 32
# STORE_ADMIN_SETUP_TOKEN=

# OAuth2 issuers are NOT configured here any more: sign in to the admin console and add them
# under "OAuth2 配置". `STORE_BOOTSTRAP_ISSUER` / `STORE_BOOTSTRAP_ADMINS` were removed on
# 2026-10-25 (knowledge/decisions/2026-10-25-admin-local-identity.md).

# GitHub App credentials are NOT configured here any more: sign in to the admin console and fill
# them in under "GitHub App" (`/<STORE_ADMIN_PATH>/settings/github`, default `/admin/settings/github`).
# `GITHUB_APP_ID` / `GITHUB_APP_SLUG` / `GITHUB_WEBHOOK_SECRET` / `GITHUB_APP_PRIVATE_KEYS` /
# `GITHUB_API_BASE_URL` were removed on 2026-10-25: they are runtime configuration an operator
# rotates, so they live in `github_app_config` + `github_app_private_keys` and are encrypted with
# the `STORE_SECRET_KEYS` keyring above. See docs/github-app.md.
